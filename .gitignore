# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Secrets — never commit real env files. Only .env.example is tracked.
.env
.env.*
!.env.example

# Credentials / keys
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
.npmrc
.netrc
**/service-account*.json
**/*credentials*.json

# Supabase CLI local state (project refs, pooler URLs, version pins)
supabase/.temp/
.branches/

# Test + build artifacts
test-results/
playwright-report/
blob-report/
coverage/

# Vendored agent skills — ~9MB of third-party content, re-installable from
# skills-lock.json (which is tracked). Don't bloat the repo with copies.
.agents/
.claude/skills/
.github/skills/

# graphify knowledge-graph output
graphify-out/
scripts/i18n-out.json

# Python bytecode
__pycache__/
*.pyc

# TypeScript incremental build cache (generated by `tsc -b`)
*.tsbuildinfo

# Source media kept out of the build and out of git history (see public/hero-*.webm)
media-src/
